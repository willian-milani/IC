<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <xacro:arg name="namespace" default=""/>

    <xacro:include
        filename="$(find clearpath_sensors_description)/urdf/seyond_lidar.urdf.xacro"/>


    <xacro:seyond_lidar
        name="seyond_lidar"
        parent_link="base_link">

        <origin
            xyz="0.25 0 0.45"
            rpy="0 0 0"/>

    </xacro:seyond_lidar>


    <xacro:include
        filename="$(find clearpath_sensors_description)/urdf/microstrain_imu.urdf.xacro"/>

    <xacro:microstrain_imu
        name="imu"
        parent_link="base_link"
        update_rate="100">

        <origin
            xyz="0 0 0.3"
            rpy="0 0 0"/>

    </xacro:microstrain_imu>


</robot>
